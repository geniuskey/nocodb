{
  "paths": {
    "/api/v2/tables/{modelId}/trash": {
      "parameters": [
        {
          "name": "modelId",
          "in": "path",
          "required": true,
          "description": "Unique Table ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "List Trashed Records",
        "operationId": "db-record-trash-list",
        "description": "List bounded restorable snapshots for one table",
        "tags": ["DB Record Trash"],
        "parameters": [
          { "$ref": "#/components/parameters/xc-auth" },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecordTrashList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "summary": "Trash Records",
        "operationId": "db-record-trash-create",
        "description": "Snapshot records and then delete them through the normal table CRUD path",
        "tags": ["DB Record Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecordTrashCreateReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashCreateResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "delete": {
        "summary": "Permanently Delete Trash Snapshots",
        "operationId": "db-record-trash-delete",
        "description": "Permanently remove selected trash snapshots",
        "tags": ["DB Record Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecordTrashIdsReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashDeleteResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v2/tables/{modelId}/trash/restore": {
      "parameters": [
        {
          "name": "modelId",
          "in": "path",
          "required": true,
          "description": "Unique Table ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Restore Trashed Records",
        "operationId": "db-record-trash-restore",
        "description": "Reinsert selected snapshots through the normal table CRUD path and remove the snapshots after success",
        "tags": ["DB Record Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordTrashRestoreReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashRestoreResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v2/tables/{modelId}/trash/conflicts": {
      "parameters": [
        {
          "name": "modelId",
          "in": "path",
          "required": true,
          "description": "Unique Table ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Analyze Record Restore Conflicts",
        "operationId": "db-record-trash-conflict-list",
        "description": "Analyze selected snapshots without mutating records or Trash",
        "tags": ["DB Record Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecordTrashIdsReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashConflictAnalysis"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v2/meta/bases/{baseId}/trash": {
      "parameters": [
        {
          "name": "baseId",
          "in": "path",
          "required": true,
          "description": "Unique Base ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "List Base Trash Entries",
        "operationId": "db-base-trash-list",
        "description": "List grouped trash operations for one base",
        "tags": ["DB Base Trash"],
        "parameters": [
          { "$ref": "#/components/parameters/xc-auth" },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BaseTrashList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "delete": {
        "summary": "Empty Base Trash",
        "operationId": "db-base-trash-empty",
        "description": "Permanently remove all record and view trash entries in one base",
        "tags": ["DB Base Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashDeleteResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v2/meta/bases/{baseId}/trash/{trashEntryId}/restore": {
      "parameters": [
        {
          "name": "baseId",
          "in": "path",
          "required": true,
          "description": "Unique Base ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        },
        {
          "name": "trashEntryId",
          "in": "path",
          "required": true,
          "description": "Unique Base Trash Entry ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Restore Base Trash Entry",
        "operationId": "db-base-trash-restore",
        "description": "Restore every remaining record snapshot in a grouped trash operation",
        "tags": ["DB Base Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordTrashRestoreModeReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashRestoreResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v2/meta/bases/{baseId}/trash/{trashEntryId}/conflicts": {
      "parameters": [
        {
          "name": "baseId",
          "in": "path",
          "required": true,
          "description": "Unique Base ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        },
        {
          "name": "trashEntryId",
          "in": "path",
          "required": true,
          "description": "Unique Base Trash Entry ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "Analyze Base Trash Record Conflicts",
        "operationId": "db-base-trash-conflict-list",
        "description": "Analyze a grouped record entry without mutating records or Trash",
        "tags": ["DB Base Trash"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTrashConflictAnalysis"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RecordTrash": {
        "title": "Record Trash Snapshot",
        "type": "object",
        "required": [
          "id",
          "fk_model_id",
          "record_id",
          "pk_data",
          "row_data",
          "deleted_at",
          "expires_at"
        ],
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "fk_model_id": { "$ref": "#/components/schemas/Id" },
          "fk_trash_entry_id": { "$ref": "#/components/schemas/Id" },
          "record_id": { "type": "string", "maxLength": 2048 },
          "pk_data": { "type": "object", "additionalProperties": true },
          "row_data": { "type": "object", "additionalProperties": true },
          "field_map": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "deleted_by": { "$ref": "#/components/schemas/Id" },
          "deleted_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "base_id": { "$ref": "#/components/schemas/Id" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RecordTrashCreateReq": {
        "title": "Record Trash Create Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["records"],
        "properties": {
          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": true
            }
          }
        }
      },
      "RecordTrashIdsReq": {
        "title": "Record Trash IDs Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["trash_ids"],
        "properties": {
          "trash_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/Id" }
          }
        }
      },
      "RecordTrashRestoreModeReq": {
        "title": "Record Trash Restore Mode Request",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["strict", "clean", "force"],
            "default": "strict"
          }
        }
      },
      "RecordTrashRestoreReq": {
        "title": "Record Trash Restore Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["trash_ids"],
        "properties": {
          "trash_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/Id" }
          },
          "mode": {
            "type": "string",
            "enum": ["strict", "clean", "force"],
            "default": "strict"
          }
        }
      },
      "RecordTrashConflictIssue": {
        "title": "Record Trash Conflict Issue",
        "type": "object",
        "required": ["type", "message", "clearable"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["primary_key", "unique", "format"]
          },
          "column_id": { "$ref": "#/components/schemas/Id" },
          "field": { "type": "string" },
          "message": { "type": "string" },
          "clearable": { "type": "boolean" }
        }
      },
      "RecordTrashConflict": {
        "title": "Record Trash Conflict",
        "type": "object",
        "required": ["trash_id", "record_id", "issues"],
        "properties": {
          "trash_id": { "$ref": "#/components/schemas/Id" },
          "record_id": { "type": "string" },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordTrashConflictIssue"
            }
          }
        }
      },
      "RecordTrashConflictAnalysis": {
        "title": "Record Trash Conflict Analysis",
        "type": "object",
        "required": ["total", "clean", "conflicted", "truncated", "conflicts"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "clean": { "type": "integer", "minimum": 0 },
          "conflicted": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" },
          "conflicts": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/RecordTrashConflict" }
          }
        }
      },
      "RecordTrashList": {
        "title": "Record Trash List",
        "type": "object",
        "required": ["list", "pageInfo"],
        "properties": {
          "list": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecordTrash" }
          },
          "pageInfo": { "$ref": "#/components/schemas/Paginated" }
        }
      },
      "RecordTrashCreateResponse": {
        "title": "Record Trash Create Response",
        "type": "object",
        "required": ["list", "trash_entry_id"],
        "properties": {
          "trash_entry_id": { "$ref": "#/components/schemas/Id" },
          "list": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecordTrash" }
          }
        }
      },
      "RecordTrashRestoreResponse": {
        "title": "Record Trash Restore Response",
        "type": "object",
        "required": ["restored"],
        "properties": {
          "restored": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "conflicted": { "type": "integer", "minimum": 0 },
          "resource_type": { "type": "string", "enum": ["view", "table"] },
          "resource_id": { "$ref": "#/components/schemas/Id" },
          "parent_id": { "$ref": "#/components/schemas/Id" }
        }
      },
      "RecordTrashDeleteResponse": {
        "title": "Record Trash Delete Response",
        "type": "object",
        "required": ["deleted"],
        "properties": { "deleted": { "type": "integer", "minimum": 0 } }
      },
      "BaseTrashEntry": {
        "title": "Base Trash Entry",
        "type": "object",
        "required": [
          "id",
          "resource_type",
          "resource_id",
          "deleted_at",
          "expires_at",
          "record_count",
          "records"
        ],
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "resource_type": {
            "type": "string",
            "enum": ["records", "view", "table"]
          },
          "resource_id": { "$ref": "#/components/schemas/Id" },
          "resource_name": { "type": "string", "maxLength": 255 },
          "parent_id": { "$ref": "#/components/schemas/Id" },
          "view_type": { "type": "integer" },
          "deleted_by": { "$ref": "#/components/schemas/Id" },
          "deleted_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "base_id": { "$ref": "#/components/schemas/Id" },
          "record_count": { "type": "integer", "minimum": 0 },
          "records": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/components/schemas/RecordTrash" }
          }
        }
      },
      "BaseTrashList": {
        "title": "Base Trash List",
        "type": "object",
        "required": ["list", "pageInfo"],
        "properties": {
          "list": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BaseTrashEntry" }
          },
          "pageInfo": { "$ref": "#/components/schemas/Paginated" }
        }
      }
    }
  }
}
