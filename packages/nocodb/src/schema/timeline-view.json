{
  "paths": {
    "/api/v1/db/meta/tables/{tableId}/timelines": {
      "parameters": [
        {
          "name": "tableId",
          "in": "path",
          "required": true,
          "description": "Unique Table ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Create Timeline View",
        "operationId": "db-view-timeline-create",
        "description": "Create a timeline view in a table",
        "tags": ["DB View"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ViewCreateReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/View" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/timelines/{viewId}": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "Read Timeline View",
        "operationId": "db-view-timeline-read",
        "description": "Read timeline presentation settings",
        "tags": ["DB View"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Timeline" }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Timeline View",
        "operationId": "db-view-timeline-update",
        "description": "Update timeline presentation settings",
        "tags": ["DB View"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TimelineUpdateReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/View" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/timeline-data/{viewId}": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Timeline View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "List Timeline Records in a Bounded Range",
        "operationId": "db-timeline-view-row-list",
        "description": "List records overlapping a required half-open calendar range. The range and page size are server bounded.",
        "tags": ["DB Timeline View Row"],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Inclusive range start in YYYY-MM-DD format",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Exclusive range end in YYYY-MM-DD format",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size; defaults to 500 and cannot exceed 1000",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based record offset",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Optional comma-separated fields; Timeline mapping fields are always returned",
            "schema": { "type": "string" }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Optional sort expression applied over the view sort",
            "schema": { "type": "string" }
          },
          {
            "name": "where",
            "in": "query",
            "description": "Optional filter expression ANDed with the Timeline range and view filters",
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/xc-auth" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineRangeResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Timeline": {
        "title": "Timeline View Model",
        "description": "Date mapping and presentation settings for a timeline view",
        "type": "object",
        "properties": {
          "base_id": { "$ref": "#/components/schemas/Id" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "fk_view_id": { "$ref": "#/components/schemas/Id" },
          "fk_title_column_id": { "$ref": "#/components/schemas/Id" },
          "fk_start_column_id": { "$ref": "#/components/schemas/Id" },
          "fk_end_column_id": { "$ref": "#/components/schemas/Id" },
          "zoom": {
            "type": "string",
            "enum": ["day", "week", "month", "quarter"],
            "default": "week"
          },
          "meta": { "$ref": "#/components/schemas/Meta" },
          "columns": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TimelineColumn" }
          }
        }
      },
      "TimelineColumn": {
        "title": "Timeline View Column Model",
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "base_id": { "$ref": "#/components/schemas/Id" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "fk_view_id": { "$ref": "#/components/schemas/Id" },
          "fk_column_id": { "$ref": "#/components/schemas/Id" },
          "show": { "$ref": "#/components/schemas/Bool" },
          "order": { "type": "number" }
        }
      },
      "TimelineUpdateReq": {
        "title": "Timeline View Update Model",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fk_title_column_id": {
            "$ref": "#/components/schemas/StringOrNull"
          },
          "fk_start_column_id": {
            "$ref": "#/components/schemas/StringOrNull"
          },
          "fk_end_column_id": {
            "$ref": "#/components/schemas/StringOrNull"
          },
          "zoom": {
            "type": "string",
            "enum": ["day", "week", "month", "quarter"]
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "TimelineColumnReq": {
        "title": "Timeline View Column Update Model",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": { "$ref": "#/components/schemas/Bool" },
          "order": { "type": "number" }
        }
      },
      "TimelineRangeResponse": {
        "title": "Timeline Range Response",
        "type": "object",
        "required": ["list", "pageInfo"],
        "properties": {
          "list": {
            "type": "array",
            "description": "Records overlapping the requested Timeline range",
            "items": { "type": "object", "additionalProperties": true }
          },
          "pageInfo": { "$ref": "#/components/schemas/Paginated" }
        }
      }
    }
  }
}
