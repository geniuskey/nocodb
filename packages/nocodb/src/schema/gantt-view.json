{
  "paths": {
    "/api/v1/db/meta/tables/{tableId}/gantts": {
      "parameters": [
        {
          "name": "tableId",
          "in": "path",
          "required": true,
          "description": "Unique Table ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Create Gantt View",
        "operationId": "db-view-gantt-create",
        "description": "Create a Gantt view in a table",
        "tags": ["DB View"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ViewCreateReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/View" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/gantts/{viewId}": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "Read Gantt View",
        "operationId": "db-view-gantt-read",
        "description": "Read Gantt presentation settings",
        "tags": ["DB View"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Gantt" }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Gantt View",
        "operationId": "db-view-gantt-update",
        "description": "Update Gantt presentation settings",
        "tags": ["DB View"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GanttUpdateReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/View" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/gantt-data/{viewId}": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "summary": "List Gantt Tasks in a Bounded Range",
        "operationId": "db-gantt-view-row-list",
        "description": "List tasks overlapping a required half-open calendar range. The range and page size are server bounded.",
        "tags": ["DB Gantt View Row"],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Inclusive range start in YYYY-MM-DD format",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Exclusive range end in YYYY-MM-DD format",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size; defaults to 500 and cannot exceed 1000",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based record offset",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Optional comma-separated fields; Gantt mapping fields are always returned",
            "schema": { "type": "string" }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Optional sort expression applied over the view sort",
            "schema": { "type": "string" }
          },
          {
            "name": "where",
            "in": "query",
            "description": "Optional filter expression ANDed with the Gantt range and view filters",
            "schema": { "type": "string" }
          },
          { "$ref": "#/components/parameters/xc-auth" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GanttRangeResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/gantts/{viewId}/schedule/preview": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Preview Gantt Schedule Propagation",
        "operationId": "db-gantt-schedule-preview",
        "description": "Compute a deterministic forward-only schedule without changing records",
        "tags": ["DB Gantt Schedule"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GanttSchedulePreviewReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GanttSchedulePlan" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/gantts/{viewId}/schedule/apply": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Apply Gantt Schedule Propagation",
        "operationId": "db-gantt-schedule-apply",
        "description": "Recompute and atomically apply a previously previewed schedule when its hash is still current",
        "tags": ["DB Gantt Schedule"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GanttScheduleApplyReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GanttSchedulePlan" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/gantts/{viewId}/dependencies/query": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Query Gantt Dependencies",
        "operationId": "db-gantt-dependency-query",
        "description": "List dependency edges whose endpoints are both present in the supplied bounded task set",
        "tags": ["DB Gantt Dependency"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GanttDependencyQueryReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GanttDependencyList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/gantts/{viewId}/dependencies": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "post": {
        "summary": "Create Gantt Dependency",
        "operationId": "db-gantt-dependency-create",
        "description": "Create an acyclic dependency edge between two records in the Gantt table",
        "tags": ["DB Gantt Dependency"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GanttDependencyCreateReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GanttDependency" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/db/meta/gantts/{viewId}/dependencies/{dependencyId}": {
      "parameters": [
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt View ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        },
        {
          "name": "dependencyId",
          "in": "path",
          "required": true,
          "description": "Unique Gantt Dependency ID",
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "patch": {
        "summary": "Update Gantt Dependency",
        "operationId": "db-gantt-dependency-update",
        "description": "Update the dependency kind or whole-day lag without changing its endpoints",
        "tags": ["DB Gantt Dependency"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GanttDependencyUpdateReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GanttDependency" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "delete": {
        "summary": "Delete Gantt Dependency",
        "operationId": "db-gantt-dependency-delete",
        "description": "Delete one dependency edge from a Gantt view",
        "tags": ["DB Gantt Dependency"],
        "parameters": [{ "$ref": "#/components/parameters/xc-auth" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "$ref": "#/components/schemas/Id" } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Gantt": {
        "title": "Gantt View Model",
        "description": "Task mapping and presentation settings for a Gantt view",
        "type": "object",
        "properties": {
          "base_id": { "$ref": "#/components/schemas/Id" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "fk_view_id": { "$ref": "#/components/schemas/Id" },
          "fk_title_column_id": { "$ref": "#/components/schemas/Id" },
          "fk_start_column_id": { "$ref": "#/components/schemas/Id" },
          "fk_end_column_id": { "$ref": "#/components/schemas/Id" },
          "fk_progress_column_id": { "$ref": "#/components/schemas/Id" },
          "fk_milestone_column_id": { "$ref": "#/components/schemas/Id" },
          "zoom": {
            "type": "string",
            "enum": ["day", "week", "month", "quarter"],
            "default": "week"
          },
          "meta": { "$ref": "#/components/schemas/Meta" },
          "columns": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GanttColumn" }
          }
        }
      },
      "GanttColumn": {
        "title": "Gantt View Column Model",
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "base_id": { "$ref": "#/components/schemas/Id" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "fk_view_id": { "$ref": "#/components/schemas/Id" },
          "fk_column_id": { "$ref": "#/components/schemas/Id" },
          "show": { "$ref": "#/components/schemas/Bool" },
          "order": { "type": "number" }
        }
      },
      "GanttUpdateReq": {
        "title": "Gantt View Update Model",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fk_title_column_id": { "$ref": "#/components/schemas/StringOrNull" },
          "fk_start_column_id": { "$ref": "#/components/schemas/StringOrNull" },
          "fk_end_column_id": { "$ref": "#/components/schemas/StringOrNull" },
          "fk_progress_column_id": {
            "$ref": "#/components/schemas/StringOrNull"
          },
          "fk_milestone_column_id": {
            "$ref": "#/components/schemas/StringOrNull"
          },
          "zoom": {
            "type": "string",
            "enum": ["day", "week", "month", "quarter"]
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "GanttColumnReq": {
        "title": "Gantt View Column Update Model",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": { "$ref": "#/components/schemas/Bool" },
          "order": { "type": "number" }
        }
      },
      "GanttRangeResponse": {
        "title": "Gantt Range Response",
        "type": "object",
        "required": ["list", "pageInfo"],
        "properties": {
          "list": {
            "type": "array",
            "description": "Tasks overlapping the requested Gantt range",
            "items": { "type": "object", "additionalProperties": true }
          },
          "pageInfo": { "$ref": "#/components/schemas/Paginated" }
        }
      },
      "GanttDependency": {
        "title": "Gantt Dependency Model",
        "description": "A directed scheduling dependency between two records in one Gantt view",
        "type": "object",
        "required": [
          "id",
          "fk_view_id",
          "source_record_id",
          "target_record_id",
          "dependency_type",
          "lag_days"
        ],
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "base_id": { "$ref": "#/components/schemas/Id" },
          "source_id": { "$ref": "#/components/schemas/Id" },
          "fk_view_id": { "$ref": "#/components/schemas/Id" },
          "source_record_id": { "type": "string", "maxLength": 2048 },
          "target_record_id": { "type": "string", "maxLength": 2048 },
          "dependency_type": {
            "type": "string",
            "enum": [
              "finish_start",
              "start_start",
              "finish_finish",
              "start_finish"
            ]
          },
          "lag_days": { "type": "integer", "minimum": -3650, "maximum": 3650 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "GanttDependencyCreateReq": {
        "title": "Gantt Dependency Create Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["source_record_id", "target_record_id"],
        "properties": {
          "source_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "target_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "dependency_type": {
            "type": "string",
            "enum": [
              "finish_start",
              "start_start",
              "finish_finish",
              "start_finish"
            ],
            "default": "finish_start"
          },
          "lag_days": {
            "type": "integer",
            "minimum": -3650,
            "maximum": 3650,
            "default": 0
          }
        }
      },
      "GanttDependencyUpdateReq": {
        "title": "Gantt Dependency Update Request",
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "dependency_type": {
            "type": "string",
            "enum": [
              "finish_start",
              "start_start",
              "finish_finish",
              "start_finish"
            ]
          },
          "lag_days": { "type": "integer", "minimum": -3650, "maximum": 3650 }
        }
      },
      "GanttDependencyQueryReq": {
        "title": "Gantt Dependency Query Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["record_ids"],
        "properties": {
          "record_ids": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      },
      "GanttDependencyList": {
        "title": "Gantt Dependency List",
        "type": "object",
        "required": ["list"],
        "properties": {
          "list": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GanttDependency" }
          }
        }
      },
      "GanttSchedulePreviewReq": {
        "title": "Gantt Schedule Preview Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_record_ids"],
        "properties": {
          "anchor_record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      },
      "GanttScheduleApplyReq": {
        "title": "Gantt Schedule Apply Request",
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_record_ids", "plan_hash"],
        "properties": {
          "anchor_record_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "GanttScheduleChange": {
        "title": "Gantt Schedule Change",
        "type": "object",
        "required": [
          "record_id",
          "previous_start",
          "previous_end",
          "next_start",
          "next_end",
          "delta_days",
          "driving_dependency_ids"
        ],
        "properties": {
          "record_id": { "type": "string" },
          "title": { "type": "string" },
          "previous_start": { "type": "string" },
          "previous_end": { "$ref": "#/components/schemas/StringOrNull" },
          "next_start": { "type": "string" },
          "next_end": { "$ref": "#/components/schemas/StringOrNull" },
          "delta_days": { "type": "integer", "minimum": 1 },
          "driving_dependency_ids": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Id" }
          }
        }
      },
      "GanttSchedulePlan": {
        "title": "Gantt Schedule Plan",
        "type": "object",
        "required": [
          "plan_hash",
          "anchor_record_ids",
          "changes",
          "unchanged_count",
          "applied"
        ],
        "properties": {
          "plan_hash": { "type": "string" },
          "anchor_record_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "changes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GanttScheduleChange" }
          },
          "unchanged_count": { "type": "integer", "minimum": 0 },
          "applied": { "type": "boolean" }
        }
      }
    }
  }
}
